{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/laer2day/canon/main/spec/personas/job.schema.json",
  "title": "Canon persona jobs (DRAFT, non-normative)",
  "description": "What the orchestrator assigns. The MCP bootstrap writes this shape. It does not embed persona instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs"],
  "properties": {
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "persona", "files", "reason", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "persona": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "files": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "enum": ["tested", "documented", "observed", "design"] }
        }
      }
    }
  }
}
